{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "casequest2026",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
